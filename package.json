{
  "name": "simple-get-github-project-info",
  "version": "1.0.0",
  "description": "简单的获取github项目信息的工具",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node --env-file=.env --use-env-proxy --use-system-ca --watch ./dist/index.js"
  },
  "keywords": [
    "github",
    "repositories",
    "info",
    "simple"
  ],
  "author": "shf-ns",
  "repository": {
    "type": "git",
    "url": "https://github.com/shf-ns/simple-get-github-info.git"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}